# Server
PORT=4000
NODE_ENV=development
CLIENT_DASHBOARD_URL=http://localhost:3000

# Database (Supabase Postgres connection string - Project Settings > Database)
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # server-only, never expose to the frontend
SUPABASE_JWT_SECRET=your_jwt_secret                # Project Settings > API > JWT Settings

# Service key used by the voice AI orchestrator / internal webhooks
AI_SERVICE_KEY=change_this_service_key

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_WEBSITE_PRICE_ID=price_xxx

# Email (Resend - https://resend.com)
RESEND_API_KEY=re_xxx
EMAIL_FROM="EstateCall <no-reply@estatecall.com>"
