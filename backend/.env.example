# ===== EstateCall Backend - EJEMPLO DE .env =====
# Copia este archivo a ".env" y rellena los valores. NO subas el .env real al repo.

# --- Server ---
PORT=4000
NODE_ENV=production
CLIENT_DASHBOARD_URL=https://TU-FRONTEND.vercel.app

# --- Database (Supabase Postgres - Transaction pooler, puerto 6543) ---
# Formato: postgresql://postgres:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:[TU_PASSWORD_DB]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# --- Supabase ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=[TU_SERVICE_ROLE_KEY]
# OBLIGATORIA: Supabase -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=[TU_JWT_SECRET]

# --- Service key para el orquestador de voz IA / webhooks internos ---
AI_SERVICE_KEY=[TU_AI_SERVICE_KEY]

# --- Stripe (OPCIONAL para arrancar) ---
STRIPE_SECRET_KEY=[TU_STRIPE_SECRET_KEY]
STRIPE_WEBHOOK_SECRET=[TU_STRIPE_WEBHOOK_SECRET]
STRIPE_WEBSITE_PRICE_ID=[TU_STRIPE_WEBSITE_PRICE_ID]

# --- Email / Resend (OPCIONAL para arrancar) ---
RESEND_API_KEY=[TU_RESEND_API_KEY]
EMAIL_FROM=onboarding@resend.dev
